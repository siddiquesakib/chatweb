# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Auth.js (Google OAuth)
AUTH_GOOGLE_ID=<google-oauth-client-id>
AUTH_GOOGLE_SECRET=<google-oauth-client-secret>

# Auth.js encryption secret (run: openssl rand -base64 32)
AUTH_SECRET=<random-64-char-hex-or-base64-secret>

# Pusher (real-time messaging)
PUSHER_APP_ID=<pusher-app-id>
PUSHER_KEY=<pusher-key>
PUSHER_SECRET=<pusher-secret>
PUSHER_CLUSTER=<pusher-cluster-region>

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000


git add .gitignore
git commit -m "chore: add gitignore rules"

git add .env.example
git commit -m "chore: add environment variables template"

